.venv/
.ipynb_checkpoints/
__pycache__/
*.py[cod]
.DS_Store

# LaTeX build artifacts
*.aux
*.log
*.out
*.bbl
*.blg
*.synctex.gz
*.fdb_latexmk
*.fls

# Datasets and checkpoints stay local
data/*
!data/README.md
ckpts/

# Superseded exploratory notebooks and their artifacts. The analyses they
# contained are reimplemented under src/meshlens with tests; these are kept on
# disk for reference but are not part of the repository.
*.ipynb
baseline_tokens_1000.pkl
exp1_remove_bos_entropy.png
exp1_remove_bos_meshes.png

# Figures belonging to the earlier draft, superseded by figures/make_figures.py
paper/figures/*.png

# ...but the paper ships its bibliography so the build needs no bibtex pass
!paper/main.bbl

# IEEEtran is not in the TeX distribution here; vendored so the paper builds anywhere
!paper/IEEEtran.cls
!paper/IEEEtran.bst
